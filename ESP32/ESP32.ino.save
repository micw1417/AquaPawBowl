#include <SPI.h>
#include <WiFi.h>
#include "Credentials.h"
#include "Globals.h"

// ===== PINS =====
// GPIO Data 
#define FLOAT_PIN       4


// ===== GLOBALS (DEFINED HERE) =====
int seconds = 0;
unsigned long lastSecondTick = 0;
bool sendingEnabled = true;
int displayMode = 0;
String email = "";

// assuming LOW = not triggered for now
bool floatTriggered = false;

// ===== TIMERS =====
unsigned long lastSend = 0;
unsigned long lastFloatRead = 0;


void setup()
{
  Serial.begin(115200);
  Serial.println("BOOT START");
  delay(1000);
  Serial.println("BOOT OK");

  pinMode(FLOAT_PIN, INPUT_PULLUP);

  WiFi.begin(ssid, password);

  // wait for connection
  while (WiFi.status() != WL_CONNECTED)
  {
    delay(500);
    Serial.print(".");
  }
  
  
  Serial.println("\nWiFi CONNECTED");
  Serial.println(WiFi.localIP());

  // TODO have led flash if it has an LED when its connected 
  
  extern WiFiServer server;
  server.begin();


}



void loop()
{
  handleClient();

  // ===== TIMER =====
  if (millis() - lastSecondTick >= 1000)
  {
    lastSecondTick = millis();
    seconds++;
  }

  // ===== Read Sensors Every 500 milisecond =====
  if (millis() - lastFloatRead >= 500)
{
  lastFloatRead = millis();

  floatTriggered = digitalRead(FLOAT_PIN) == LOW;

}
  // ===== SEND DATA =====
  if (sendingEnabled && millis() - lastSend > 500)
  {
    lastSend = millis();
    sendData(floatTriggered, WiFi.RSSI(), getMacString());
  }
  delay(50);
}


// ===== SEND DATA =====
void sendData(bool floatTriggered, int rssi, String mac)
{
  WiFiClient client;
  client.setTimeout(500);

  // TOOD CHANGE
  // Windows hotspot
  const char* host = "192.168.137.1";
  const int port = 5000;

  if (!client.connect(host, port))
  {
    Serial.println("CONN FAIL");
    return;
  }

  String json =
  String("{\"floatTriggered\":") + (floatTriggered ? "true" : "false") +
  ",\"rssi\":" + rssi +
  ",\"seconds\":" + seconds +
  ",\"sending\":" + (sendingEnabled ? "true" : "false") +
  ",\"mac\":\"" + mac + "\"}";

  client.println("POST /data HTTP/1.1");
  client.println("Host: " + String(host));
  client.println("Content-Type: application/json");
  client.print("Content-Length: ");
  client.println(json.length());
  client.println();
  client.println(json);

  client.stop();
}

// ===== MAC =====
String getMacString()
{
  byte mac[6];
  WiFi.macAddress(mac);

  String result;
  for (int i = 0; i < 6; i++)
  {
    if (mac[i] < 16) result += "0";
    result += String(mac[i], HEX);
    if (i < 5) result += ":";
  }
  return result;
}
